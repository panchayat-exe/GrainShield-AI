# GrainShield AI — AI Model Server Environment Variables
# Copy this file to .env and fill in your values.

# Path to trained YOLO model weights (best.pt from training run)
# If not set, falls back to yolo26n.pt (base model — lower plate accuracy)
MODEL_PATH=

# Path to tesseract binary (auto-detected on most systems)
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default:   /usr/bin/tesseract
TESSERACT_CMD=

# Optional: API key to protect the /verify endpoint
# Set the same value in ai-worker .env as CV_API_KEY
CV_API_KEY=

# Max uploaded image size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Server host and port
HOST=127.0.0.1
PORT=8000
