# GrainShield AI -- Inference Server Environment Variables
# Copy to .env and fill in real values.

# API key for /verify endpoint authentication (required in production)
CV_API_KEY=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Deployment environment: development | production
# In production, CV_API_KEY must be set or server will not start.
ENVIRONMENT=development

# Override Tesseract binary path (auto-detected if not set)
TESSERACT_CMD=

# Override YOLO model path (auto-detected if not set)
MODEL_PATH=

# Maximum uploaded file size in bytes (default 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Server bind settings
HOST=127.0.0.1
PORT=8000