# ============================================================
# GrainShield AI — AI Worker Server Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ------------------------------------
# Supabase — service role (server only, never expose to browser)
# Replace with the real secret key from:
# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
# ------------------------------------
SUPABASE_URL=https://umkjdpgxxylckoohnyco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ------------------------------------
# AI Computer Vision Provider
#
# Development / Local Direct Run:
#   CV_PROVIDER=http
#   CV_API_URL=http://127.0.0.1:8000/verify
#
# Docker Compose Internal Network:
#   CV_PROVIDER=http
#   CV_API_URL=http://ai-inference:8000/verify
#
# Production Cloud / Dedicated Inference Host:
#   CV_PROVIDER=http
#   CV_API_URL=https://ai.grainshield.gov.in/verify
#   CV_API_KEY=YOUR_PRODUCTION_CV_API_KEY
# ------------------------------------
CV_PROVIDER=http
CV_API_URL=http://127.0.0.1:8000/verify
CV_API_KEY=

# ------------------------------------
# Worker settings
# ------------------------------------
# How often to poll for pending verifications (milliseconds)
POLL_INTERVAL_MS=15000
# Max retries per verification job
MAX_RETRIES=3
# Processing timeout (milliseconds)
PROCESSING_TIMEOUT_MS=90000
