# ============================================================
# GrainShield AI — AI Worker Server Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ------------------------------------
# Supabase — service role (server only, never expose to browser)
# ------------------------------------
SUPABASE_URL=https://umkjdpgxxylckoohnyco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_SERVICE_ROLE_KEY

# ------------------------------------
# AI Computer Vision Provider
# Replace with your actual CV provider URL and key.
# Supported adapters: mock | grainshield_cv | google_vision | azure_vision | custom
# ------------------------------------
CV_PROVIDER=mock
CV_API_URL=https://your-cv-api.example.com/verify
CV_API_KEY=your-cv-api-key-here

# ------------------------------------
# Worker settings
# ------------------------------------
# How often to poll for pending verifications (milliseconds)
POLL_INTERVAL_MS=15000
# Max retries per verification job
MAX_RETRIES=3
# Processing timeout (milliseconds)
PROCESSING_TIMEOUT_MS=30000
