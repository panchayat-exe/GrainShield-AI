# GrainShield AI — Admin Frontend Environment Variables
# Copy this file to .env and fill in your values.
# These are PUBLIC — baked into the client bundle. Do NOT put secrets here.

# Supabase project URL (from Supabase dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (safe to expose)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
