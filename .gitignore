# ============================================================
# GrainShield AI — Root .gitignore
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
.tanstack/

# ── Environment secrets — NEVER commit real credentials ──────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
ai-worker/.env
ai-worker/.env.local

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Wrangler / Cloudflare ────────────────────────────────────
.wrangler/
.dev.vars

# ── OS / Editor artifacts ────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Python / AI Model ────────────────────────────────────────
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
runs/
ai-model/datasets/
datasets/
.cache/

# -- Apps --------------------------------------------------
apps/admin/.env
apps/admin/.env.local
apps/admin/.env.*.local

# -- AI Model weights (large binary files, download separately) --
ai-model/weights/*.pt
ai-model/weights/*.onnx
ai-model/weights/*.bin
# Exception: keep the placeholder/base weights in git (small)
!ai-model/weights/.gitkeep

# -- Python test/validation artifacts --
ai-model/validation/validation_results.json
ai-model/.pytest_cache/
ai-model/benchmark_results.csv
ai-model/test_images/benchmark_results.csv
