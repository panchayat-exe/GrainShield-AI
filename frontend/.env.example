# ============================================================
# GrainShield AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# ------------------------------------
# Supabase — client-side (safe to expose to browser)
# ------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ------------------------------------
# Supabase — server-side ONLY (never expose to browser)
# Used only in server functions / Edge Functions.
# ------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Keep secret — grants full DB access

# ------------------------------------
# App
# ------------------------------------
# VITE_APP_URL=https://your-deployed-app.com
